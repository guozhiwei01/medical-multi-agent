# ============================================
# 医疗报告分析多智能体 - 环境变量配置
# ============================================
# 复制此文件为 .env，填入你的 API Key

# --- LLM API 配置 ---
# 使用 OpenAI 兼容接口，支持豆包/通义千问等

# 通义千问（DashScope）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 如果使用豆包（Doubao/Ark），取消注释并填写：
# ARK_API_KEY=your_ark_api_key_here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=your_model_endpoint_id
